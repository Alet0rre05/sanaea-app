# ==============================================================
# Variables de entorno — copiar a `.env` y completar.
# NUNCA commitear el archivo `.env` real.
# Las marcadas OBLIGATORIA fallan al arrancar si faltan.
# ==============================================================

# --- Django -------------------------------------------------------
# OBLIGATORIA. python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Redirección a HTTPS y HSTS (activos cuando DJANGO_DEBUG=False).
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=0

# --- PostgreSQL (Neon) — OBLIGATORIAS ------------------------------
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_HOST=CHANGE_ME.neon.tech
DB_PORT=5432
# Neon exige SSL. Usar "disable" solo en una base local sin SSL.
DB_SSLMODE=require

# --- Cifrado a nivel de campo (PHI) — OBLIGATORIA -------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Perderla implica perder el acceso a los datos cifrados.
FIELD_ENCRYPTION_KEY=CHANGE_ME

# --- JWT ------------------------------------------------------------
# OBLIGATORIA. Debe ser distinta de DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=CHANGE_ME
# Access token: 15 minutos según el documento maestro.
JWT_ACCESS_TOKEN_MINUTES=15
# OBLIGATORIA. Duración del refresh token: NO definida en el documento maestro.
JWT_REFRESH_TOKEN_DAYS=CHANGE_ME

# --- OTP (códigos por correo) — OBLIGATORIAS (no definidas en el documento)
OTP_EXPIRY_MINUTES=CHANGE_ME
OTP_MAX_ATTEMPTS=CHANGE_ME

# --- Cloudflare Turnstile — OBLIGATORIA -----------------------------
TURNSTILE_SECRET_KEY=CHANGE_ME
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# --- Frontend y CORS ------------------------------------------------
# Orígenes del frontend (Vercel), separados por coma. Ej: https://app.ajrdata.com.ar
CORS_ALLOWED_ORIGINS=

# --- Correo electrónico --------------------------------------------
# Remitente definido en el documento maestro.
DEFAULT_FROM_EMAIL=no-reply@ajrdata.com.ar
# Desarrollo: consola. Producción: SMTP (proveedor pendiente de definir).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Archivos privados y OCR ----------------------------------------
# Carpeta de planillas escaneadas. No se sirve públicamente.
MEDIA_ROOT=./private_media
# Motor de OCR (ruta de importación). Por defecto no extrae datos.
OCR_EXTRACTOR=operations.ocr.NullOCRExtractor

# --- Legal ----------------------------------------------------------
# Tipos de documento que deben aceptarse antes de operar, separados por coma.
# Valores: TOS,PRIVACY,EULA,DPA. Vacío = no bloquea.
LEGAL_REQUIRED_KINDS=
