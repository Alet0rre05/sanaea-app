# ==============================================================
# Variables de entorno — copiar a `.env` y completar.
# NUNCA commitear el archivo `.env` real.
# ==============================================================

# --- Django -------------------------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (Neon) -------------------------------------------
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_HOST=CHANGE_ME.neon.tech
DB_PORT=5432
# Neon exige SSL. Mantener "require" salvo en entornos locales sin SSL.
DB_SSLMODE=require

# --- Cifrado a nivel de campo (PHI) ---------------------------------
# Clave Fernet (32 bytes en base64 urlsafe). Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Perderla implica perder acceso a los datos cifrados.
FIELD_ENCRYPTION_KEY=CHANGE_ME

# --- JWT (Fase 2) ---------------------------------------------------
JWT_SIGNING_KEY=CHANGE_ME
# Access Token: 15 minutos (definido en el documento maestro).
JWT_ACCESS_TOKEN_MINUTES=15
# Refresh Token rotativo: duración pendiente de definir por el equipo.
# JWT_REFRESH_TOKEN_DAYS=

# --- Cloudflare Turnstile (Fase 2) ----------------------------------
TURNSTILE_SECRET_KEY=CHANGE_ME
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# --- Correo electrónico / OTP (Fase 2) ------------------------------
# Remitente del documento maestro.
DEFAULT_FROM_EMAIL=no-reply@ajrdata.com.ar
# Proveedor SMTP: pendiente de definir. En desarrollo usar la consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=CHANGE_ME
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=True
